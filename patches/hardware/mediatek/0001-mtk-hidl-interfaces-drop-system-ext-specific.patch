From 32bd412433ef0d58c3484769d9789987407627fc Mon Sep 17 00:00:00 2001
From: X6886 Compatibility Patches <x6886-vendorsetup@localhost>
Date: Sat, 21 Nov 2026 00:00:00 +0000
Subject: [PATCH] x6886: drop system_ext_specific from MTK HIDL interfaces

Soong rejects these interfaces when their generated vendor prebuilt has a
different partition. Drop the flag from all 16 hidl_interface definitions so
they build with the standard system/vendor split. This patch is
independently applicable to a pristine hardware/mediatek tree.

---
 16 files changed, 16 deletions(-)

diff --git a/interfaces/hardware/bluetooth/audio/2.1/Android.bp b/interfaces/hardware/bluetooth/audio/2.1/Android.bp
--- a/interfaces/hardware/bluetooth/audio/2.1/Android.bp
+++ b/interfaces/hardware/bluetooth/audio/2.1/Android.bp
@@ -5,7 +5,6 @@
 hidl_interface {
     name: "vendor.mediatek.hardware.bluetooth.audio@2.1",
     root: "vendor.mediatek.hardware",
-    system_ext_specific: true,
     srcs: [
         "types.hal",
         "IBluetoothAudioPort.hal",
