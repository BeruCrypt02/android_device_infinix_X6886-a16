From 32bd412433ef0d58c3484769d9789987407627fc Mon Sep 17 00:00:00 2001
From: X6886 Compatibility Patches <x6886-vendorsetup@localhost>
Date: Fri, 20 Nov 2026 00:00:00 +0000
Subject: [PATCH] x6886: netdagent: keep HIDL interface on vendor partition

Soong rejects a system_ext_specific HIDL interface when its auto-generated
prebuilt counterpart lives on vendor. Drop the flag so both sides match.

---
 interfaces/hardware/netdagent/1.0/Android.bp | 1 -
 1 file changed, 1 deletion(-)

diff --git a/interfaces/hardware/netdagent/1.0/Android.bp b/interfaces/hardware/netdagent/1.0/Android.bp
index 46d4be8..be82523 100644
--- a/interfaces/hardware/netdagent/1.0/Android.bp
+++ b/interfaces/hardware/netdagent/1.0/Android.bp
@@ -5,7 +5,6 @@
 hidl_interface {
     name: "vendor.mediatek.hardware.netdagent@1.0",
     root: "vendor.mediatek.hardware",
-    system_ext_specific: true,
     srcs: [
         "INetdagent.hal",
     ],
-- 
2.43.0
